APP_ENV=development
LOG_LEVEL=INFO

# OpenAI API or an OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SMALL_MODEL=
LARGE_MODEL=
STRUCTURED_OUTPUT_METHOD=json_schema
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MAX_AGENT_CONTEXT_CHARS=16000
DYNAMIC_MODEL_ROUTING=true
MODEL_ROUTER_COMPLEXITY_CHARS=4000

TAVILY_API_KEY=
TOOLS_ENABLED=false
REQUIRE_EXTERNAL_EVIDENCE=true
TOOL_PERMISSIONS=search:execute,knowledge_base:read,database:read
SEARCH_MAX_CALLS_PER_RUN=100
SEARCH_MAX_CALLS_PER_TASK=10
RESEARCH_QUALITY_GATE_ENABLED=true
RESEARCH_INITIAL_SEARCHES=5
RESEARCH_FOLLOWUP_BATCH_SIZE=2
RESEARCH_MAX_SEARCHES_PER_TASK=10
RESEARCH_COMPLETION_SCORE=80
RESEARCH_MIN_UNIQUE_SOURCES=5
RESEARCH_MIN_INDEPENDENT_DOMAINS=3
RESEARCH_MAX_TOOL_ROUNDS=3
DATABASE_TOOL_ENABLED=false
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_MAX_ROWS=100
RECOVERY_ENABLED=true
RECOVERY_MAX_TOOL_RETRIES=2
RECOVERY_MAX_TASK_REPLANS=1
RECOVERY_BACKOFF_SECONDS=0.25
SAGA_BACKEND=memory
SAGA_AUTO_SETUP=true

POSTGRES_DB=research_agent
POSTGRES_USER=research_agent
POSTGRES_PASSWORD=research_agent
DATABASE_URL=postgresql://research_agent:research_agent@localhost:5432/research_agent
CHECKPOINT_BACKEND=memory
CHECKPOINT_AUTO_SETUP=true
BLACKBOARD_BACKEND=memory
LONG_TERM_MEMORY_BACKEND=memory
EPISODIC_MEMORY_BACKEND=memory
MEMORY_COMPRESSION_CHARS=8000
MEMORY_MIN_VALUE_SCORE=0.2
MEMORY_MAX_RECORDS_PER_USER=1000
EMBEDDING_DIMENSION=1024
INSTALL_RAG=false
RAG_ENABLED=false
RAG_BACKEND=postgres
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BGE_DEVICE=cpu
BGE_USE_FP16=false
RAG_CANDIDATE_K=30
RAG_TOP_K=8
RAG_RRF_K=60
RAG_CONTEXT_CHARS=12000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent-local
